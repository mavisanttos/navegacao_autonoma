<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cg_solver</name>
  <version>0.0.0</version>
  <description>Solucao do desafio de navegacao autonoma: rota otima com BFS (parte 1) e mapeamento com DFS (parte 2)</description>
  <maintainer email="maria.santos@sou.inteli.edu.br">Maria Santos</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>cg_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
